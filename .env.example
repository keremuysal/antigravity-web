# ---- Required ----
# Login PIN/password (min. 6 chars). This app can run agent tools and shell commands
# on your server, so pick something strong.
AGY_WEB_PIN=change-me-to-a-strong-pin

# ---- Optional ----
# HMAC secret for session tokens. If empty, a random one is generated and stored in .agy_web_secret
AGY_WEB_SECRET=
# Session lifetime in days
AGY_WEB_SESSION_DAYS=30
# Path to the Antigravity CLI binary
AGY_BIN=~/.local/bin/agy
# Override Antigravity data dir (default: ~/.gemini/antigravity-cli or ~/.gemini/antigravity)
ANTIGRAVITY_DATA_DIR=
# Where runtime data (pc_sync/, uploads/, settings.json) is stored (default: app directory)
AGY_WEB_DATA_DIR=
# Mini terminal in the side panel (runs arbitrary shell commands!). Off by default.
AGY_WEB_ENABLE_TERMINAL=false
# systemd services shown in the System Hub
AGY_WEB_SERVICES=agy-web,cloudflared
# Turkish voice server exposing /tts-only and /stt-only (see extras/voice_endpoints.py). Empty = voice off.
VOICE_SERVER_URL=
